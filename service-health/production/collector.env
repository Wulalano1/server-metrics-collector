OPS_PUSH_URL=https://ops-api.dev.iannil.net/api/v1/service-health/report
METRICS_PUSH_TOKEN=ops-metrics-push-iannil-2026
SERVER_ENV=production
INTERVAL_SECONDS=30

# 默认自动采集本机所有 TCP 监听端口（ss -tlnH），无需配置 PROBE_TARGETS
# 运维平台可配置「展示/告警」端口，采集脚本无需修改；若需脚本侧只探指定端口，可设 USE_OPS_PROBE_CONFIG=1
# PROBE_EXCLUDE_PORTS=22
# PROBE_TARGETS=[...]  手动指定目标（设置后不再自动发现）
