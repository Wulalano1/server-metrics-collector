OPS_PUSH_URL=https://ops-api.dev.iannil.net/api/v1/service-health/report
METRICS_PUSH_TOKEN=ops-metrics-push-iannil-2026
SERVER_ENV=staging
INTERVAL_SECONDS=30

# 默认自动采集本机所有 TCP 监听端口（ss -tlnH）
# 额外指定端口（可不在监听列表中，会与自动发现合并去重）：
# PROBE_PORTS=9999,8788
# PROBE_PORT_HOST=127.0.0.1

# 仅探测 ops 平台配置的端口（关闭自动发现）：
# USE_OPS_PROBE_CONFIG=1

# PROBE_EXCLUDE_PORTS=22
# PROBE_TARGETS=[...]  完全手动 JSON 目标（设置后优先级最高）
